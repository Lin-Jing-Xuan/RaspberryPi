#!/usr/bin/env python3
import tkinter as tk

# 创建一个主窗口
root = tk.Tk()
root.title("5个人的姓名")

# 定义5个人的姓名
names = ["U12127107 吳昕陽", "U12127108 李品叡", "U12127116 林靖玹", "U12127118 徐宏瑋", "U12127147 羅承凱","cpu:100000003a5f768d"]

# 创建一个标签来显示姓名列表
label = tk.Label(root, text="以下是5个人的姓名：")
label.pack()

# 创建一个列表框显示姓名
listbox = tk.Listbox(root)
for name in names:
    listbox.insert(tk.END, name)
listbox.pack()

# 运行主循环
root.mainloop()
